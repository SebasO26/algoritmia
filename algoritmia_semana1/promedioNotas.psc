Algoritmo promedioNotas
	Definir nota1, nota2, nota3, promedio Como Real
	
	Escribir "Cálculo del promedio de 3 notas."
	Escribir  "Ingrese su primera nota: "
	Leer nota1
	Escribir  "Ingrese su segunda nota: "
	Leer nota2
	Escribir "Ingrese su tercer nota: "
	Leer nota3
	
	promedio <- (nota1 + nota2 + nota3) / 3
	
	Escribir "El promedio de las tres notas es de: ", promedio
FinAlgoritmo
